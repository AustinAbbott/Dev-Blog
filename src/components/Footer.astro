---
const today = new Date();
---

<footer>
  <div class="inner">
    <span>&copy; {today.getFullYear()} Austin Abbott. All rights reserved.</span>
    <span class="links">
      <a href="/rss.xml">RSS</a>
      <a href="https://github.com/AustinAbbott/dev-blog" target="_blank" rel="noopener noreferrer">Source</a>
      <span>
        Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
      </span>
    </span>
  </div>
</footer>

<style>
  footer {
    max-width: var(--width);
    width: 100%;
    margin: 0 auto;
    padding: 0 1.25rem 2.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--heading);
  }

  @media (max-width: 560px) {
    footer {
      padding: 0 1rem 2rem;
    }
  }
</style>
